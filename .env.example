# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fuse_db

# Fuse API
FUSE_API_URL=
FUSE_API_KEY=

# Vendor Resilience Configuration
VENDOR_RETRY_ATTEMPTS=3
VENDOR_RETRY_INITIAL_DELAY=100
VENDOR_RETRY_MAX_DELAY=5000
VENDOR_CIRCUIT_BREAKER_THRESHOLD=5
VENDOR_CIRCUIT_BREAKER_DURATION=30000

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@fuse-trading.com

# Prisma Database Connection
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"
